//
// -----------------------------------------------------------------------------
//
RESOURCE MENU_PANE r_n70test_menu
    {
    items =
        {
        // added the new Options menu command here
        MENU_ITEM
                {
                command = EN70TestCommand1;
                txt = qtn_hewb_command1;
                },
        MENU_ITEM
                {
                command = EN70TestTenSites;
                txt = "Test 10 sites";
                },
        MENU_ITEM { command = EN70TestHttpFeatures; txt = "Test new features"; },
        MENU_ITEM { command = EN70TestApi; txt = "Test API + gzip"; },
        MENU_ITEM { command = EN70TestClient; txt = "Test client 0.9"; },
        MENU_ITEM { command = EN70TestTcp; txt = "Test TCP timeout"; },
        MENU_ITEM { command = EN70TestTimeout; txt = "Test timeout"; },
        MENU_ITEM { command = EN70TestCancellation; txt = "Test cancellation"; },
        MENU_ITEM { command = EN70TestCancel; txt = "Cancel request"; },
        MENU_ITEM
                {
                command = EAknSoftkeyExit;
                txt = qtn_hewb_exit;
                }
        };
    }

