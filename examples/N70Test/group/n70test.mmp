TARGET            N70Test.app
TARGETTYPE        app

// Change the second number here to change the UID for this application
UID               0x100039CE 0x70007121
TARGETPATH        \system\apps\n70test

SOURCEPATH        ..\src
SOURCE            N70Test.cpp
SOURCE            N70TestApplication.cpp
SOURCE            N70TestAppView.cpp
SOURCE            N70TestAppUi.cpp
SOURCE            N70TestDocument.cpp

SOURCEPATH        ..\data
RESOURCE          N70Test.rss
